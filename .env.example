# Obtain a connection string for your database from the Connection Details widget on the Neon Dashboard.
# The connection string has the format `postgres://user:pass@host/db`
DATABASE_URL="test"

# Receiptly API (kept separate from the personal-site database and credentials)
RECEIPTLY_DATABASE_URL="postgres://user:password@host/receiptly"
RECEIPTLY_TOKEN_SECRET="use-a-unique-secret-with-at-least-32-characters"
RECEIPTLY_BOOTSTRAP_TOKEN="one-time-local-or-deployment-bootstrap-token"

# Receiptly image recognition. This is the only Receiptly setting needed for the
# unauthenticated, no-database receipt scan preview API. Keep it server-only.
OPENROUTER_API_KEY="your-openrouter-key"
# Optional. Must support image inputs and strict JSON-schema structured outputs.
RECEIPTLY_OCR_MODEL="google/gemini-2.5-flash"
