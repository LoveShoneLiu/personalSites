# Obtain a connection string for your database from the Connection Details widget on the Neon Dashboard.
# The connection string has the format `postgres://user:pass@host/db`
DATABASE_URL="test"

# Receiptly API (kept separate from the personal-site database and credentials)
RECEIPTLY_DATABASE_URL="postgres://user:password@host/receiptly"
RECEIPTLY_TOKEN_SECRET="use-a-unique-secret-with-at-least-32-characters"

# Resend transactional email. Verify liushaofei.cn in Resend first.
RESEND_API_KEY="re_xxxxxxxxx"
RECEIPTLY_EMAIL_FROM="Receiptly <login@liushaofei.cn>"

# Google ID-token audiences, comma separated.
RECEIPTLY_GOOGLE_AUDIENCES="ios-client-id.apps.googleusercontent.com"

# Native Sign in with Apple.
RECEIPTLY_APPLE_CLIENT_ID="com.shaofeiliu.receiptly"
RECEIPTLY_APPLE_TEAM_ID="YOUR_TEAM_ID"
RECEIPTLY_APPLE_KEY_ID="YOUR_KEY_ID"
RECEIPTLY_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 32 random bytes encoded as base64, used to encrypt Apple refresh tokens.
RECEIPTLY_PROVIDER_ENCRYPTION_KEY="base64-encoded-32-byte-key"
RECEIPTLY_PROVIDER_ENCRYPTION_KEY_VERSION="v1"

# Receiptly image recognition. Scan routes require a Receiptly access token.
OPENROUTER_API_KEY="your-openrouter-key"
# Optional. Must support image inputs and strict JSON-schema structured outputs.
RECEIPTLY_OCR_MODEL="google/gemini-2.5-flash"
